  "authors": ["syvme"],
  "contact": {
    "homepage": "https://modrinth.com/mod/stabanimationrestorer",
    "sources": "https://github.com/syvme/stabanimationrestorer",
    "issues": "https://github.com/syvme/stabanimationrestorer/issues"
  },
  "license": "AGPL-3.0",
  "icon": "icon.png",
  "environment": "client",
  "mixins": [
    {
      "config": "stabanimationrestorer.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${minecraft_version}"
  }
}
